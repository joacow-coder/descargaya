# Puerto en el que escucha el servidor
PORT=3000

# Carpeta temporal donde se descargan y procesan los archivos
TMP_DIR=./tmp

# Duración máxima permitida por video, en segundos (10800 = 3 horas)
MAX_DURATION_SECONDS=10800

# Minutos que se conserva un trabajo/archivo temporal antes de limpiarse automáticamente
JOB_TTL_MINUTES=30

# Rutas a los binarios (deja el valor por defecto si están en el PATH del sistema)
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
